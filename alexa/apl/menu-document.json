                                    "fontSize": "11dp",
                                    "fontWeight": "700"
                                  },
                                  {
                                    "type": "Text",
                                    "text": "${data.name}",
                                    "style": "textTitle",
                                    "fontSize": "16dp",
                                    "maxLines": 2,
                                    "marginTop": "2dp"
                                  }
                                ]
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}