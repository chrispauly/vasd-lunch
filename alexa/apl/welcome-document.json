                  {
                    "type": "Container",
                    "width": "100%",
                    "height": "100%",
                    "backgroundColor": "#1E293B",
                    "borderRadius": "18dp",
                    "padding": "16dp",
                    "borderWidth": "2dp",
                    "borderColor": "rgba(249, 115, 22, 0.3)",
                    "justifyContent": "space-between",
                    "items": [
                      {
                        "type": "Container",
