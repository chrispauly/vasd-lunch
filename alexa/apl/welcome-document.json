                    "borderRadius": "18dp",
                    "padding": "16dp",
                    "borderWidth": "2dp",
                    "borderColor": "rgba(249, 115, 22, 0.3)",
                    "justifyContent": "space-between",
                    "items": [
                      {
                        "type": "Container",
                        "items": [
                          {
                            "type": "Text",
