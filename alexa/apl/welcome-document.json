                                    "items": [
                                      {
                                        "type": "Text",
                                        "text": "🥐 Breakfast",
                                        "color": "#E2E8F0",
                                        "fontWeight": "700",
                                        "fontSize": "13dp"
                                      }
                                    ]
                                  }
                                ]
                              }
                            ]
                          }
                        ]
                      }
