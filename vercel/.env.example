# Google Gemini API Key (Get a free key at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Recommended lowest-cost model: gemini-2.0-flash-lite (default) or gemini-1.5-flash-8b
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: Upstash Redis or Vercel KV for multi-region persistent edge caching
# UPSTASH_REDIS_REST_URL=https://...
# UPSTASH_REDIS_REST_TOKEN=...
